# Copy to deploy/.env on the server and fill in. NEVER commit the real .env.
# Generate secrets with:  openssl rand -hex 32

# ===== Domains (point DNS A records → this VPS first) =====
APP_DOMAIN=app.example.com          # storefront + admin
API_DOMAIN=api.example.com          # backend API
ACME_EMAIL=you@example.com          # Let's Encrypt notifications

# ===== Postgres =====
POSTGRES_USER=ekatalog
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=ekatalog

# ===== Auth & security (MUST change — do not ship defaults) =====
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_run_openssl_rand_hex_32
TOKEN_TTL_HOURS=24
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60

# ===== Seed accounts (created only on a fresh empty database) =====
# Keep SEED_DEMO=false in production so demo customers/orders are NOT created.
SEED_DEMO=false
SEED_ADMIN_NAME=Store Admin
SEED_ADMIN_EMAIL=admin@yourstore.com
SEED_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
SEED_SUPERADMIN_EMAIL=owner@yourstore.com
SEED_SUPERADMIN_PASSWORD=CHANGE_ME_strong_owner_password

# ===== Store config / integrations (optional until you have keys) =====
SHIPPING_ORIGIN_PROVINCE=DKI Jakarta
GOOGLE_CLIENT_ID=

# ===== Prebuilt images (set when deploying CI-built images from GHCR) =====
# Leave commented to build locally with `docker compose build`.
# BACKEND_IMAGE=ghcr.io/youruser/ekatalog-backend:latest
# FRONTEND_IMAGE=ghcr.io/youruser/ekatalog-frontend:latest
